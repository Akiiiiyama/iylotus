{
  "name": "@iylotus/tokens",
  "version": "0.1.0",
  "description": "IY Lotus design tokens in the W3C DTCG format, resolved to JSON and JavaScript.",
  "type": "module",
  "license": "MIT",
  "author": "Isabela Yukari",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akiiiiyama/iylotus.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/Akiiiiyama/iylotus#readme",
  "bugs": {
    "url": "https://github.com/Akiiiiyama/iylotus/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "iylotus",
    "dtcg",
    "tokens"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
