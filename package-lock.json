{
  "name": "iylotus",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "iylotus",
      "workspaces": [
        "packages/tokens",
        "packages/styles"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@iylotus/styles": {
      "resolved": "packages/styles",
      "link": true
    },
    "node_modules/@iylotus/tokens": {
      "resolved": "packages/tokens",
      "link": true
    },
    "packages/styles": {
      "name": "@iylotus/styles",
      "version": "0.0.0",
      "license": "MIT",
      "dependencies": {
        "@iylotus/tokens": "0.0.0"
      }
    },
    "packages/tokens": {
      "name": "@iylotus/tokens",
      "version": "0.0.0",
      "license": "MIT"
    }
  }
}
